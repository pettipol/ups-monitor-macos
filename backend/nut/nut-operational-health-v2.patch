+#ifdef MLINK_HIDAPI_OPERATIONAL_V2
+int mlink_shared_operational_begin(void)
+{
+	if (state.guard_started || state.attempted || state.terminal
+	 || state.health_phase != MLINK_HEALTH_DISABLED) return 0;
+	if (!microlink_usb_guard_begin(35)) return 0;
+	state.health_phase = MLINK_HEALTH_STARTING;
+	return usable();
+}
+
+int mlink_shared_operational_published(uint64_t minimum_observed_elapsed_ms)
+{
+	int64_t now;
+	uint64_t elapsed;
+	if (state.health_phase == MLINK_HEALTH_DISABLED || !usable()) return 0;
+	if (!state.admitted || !state.opened || state.in_api || !clock_now(&now)) {
+		mark_terminal();
+		return 0;
+	}
+	elapsed = (uint64_t)(now - state.guard_start_ms);
+	if (!health_sample_before_deadline(now)) return 0;
+	if (elapsed > MLINK_OPERATIONAL_MAX_ELAPSED
+	 || now > INT64_MAX - 15000 || state.publications == MLINK_OPERATIONAL_MAX_ELAPSED) {
+		state.health_reason = MLINK_HEALTH_OVERFLOW;
+		mark_terminal();
+		return 0;
+	}
+	if (minimum_observed_elapsed_ms > elapsed
+	 || (state.publications != 0 && minimum_observed_elapsed_ms <= state.minimum_observed_ms)) {
+		state.health_reason = MLINK_HEALTH_REFRESH;
+		mark_terminal();
+		return 0;
+	}
+	state.minimum_observed_ms = minimum_observed_elapsed_ms;
+	state.publications++;
+	state.deadline_ms = now + 15000;
+	state.health_phase = MLINK_HEALTH_ACTIVE;
+	return 1;
+}
+
+int mlink_shared_operational_elapsed(uint64_t *elapsed_ms)
+{
+	int64_t now;
+	if ((state.health_phase == MLINK_HEALTH_STARTING
+	 || state.health_phase == MLINK_HEALTH_ACTIVE) && !usable()) return 0;
+	if (elapsed_ms == NULL || state.health_phase == MLINK_HEALTH_DISABLED) return 0;
+	if (state.ops == NULL && (state.health_phase == MLINK_HEALTH_CLEANING
+	 || state.health_phase == MLINK_HEALTH_FINISHED)) {
+		/* Native disposal has already captured the final monotonic observation. */
+		if (!state.finish_clock_valid || state.finish_clock_ms < state.last_clock_ms
+		 || state.finish_clock_ms < state.guard_start_ms) return 0;
+		now = state.finish_clock_ms;
+	} else {
+		if (!clock_now(&now) || now < state.guard_start_ms) return 0;
+		if (!health_sample_before_deadline(now)) return 0;
+	}
+	if ((uint64_t)(now - state.guard_start_ms) > MLINK_OPERATIONAL_MAX_ELAPSED) {
+		if (!(state.ops == NULL && (state.health_phase == MLINK_HEALTH_CLEANING
+			|| state.health_phase == MLINK_HEALTH_FINISHED))) {
+			if (state.health_reason == MLINK_HEALTH_NONE)
+				state.health_reason = MLINK_HEALTH_OVERFLOW;
+			mark_terminal();
+		}
+		return 0;
+	}
+	*elapsed_ms = (uint64_t)(now - state.guard_start_ms);
+	return 1;
+}
+
+void mlink_shared_operational_stop(void)
+{
+	if (state.health_phase == MLINK_HEALTH_DISABLED) return;
+	if (state.health_reason == MLINK_HEALTH_NONE) state.health_reason = MLINK_HEALTH_STOP;
+	mark_terminal();
+}
+
+void mlink_shared_operational_fail(void)
+{
+	if (state.health_phase != MLINK_HEALTH_DISABLED) mark_terminal();
+}
+
+int mlink_shared_operational_cleanup_complete(void)
+{
+	int64_t now;
+	int clock_valid;
+	if (state.health_phase != MLINK_HEALTH_CLEANING) return 0;
+	if (state.ops != NULL) clock_valid = clock_now(&now);
+	else {
+		now = state.finish_clock_ms;
+		clock_valid = state.finish_clock_valid && now >= state.last_clock_ms;
+	}
+	if (!state.cleanup_deadline_valid || !clock_valid
+	 || now >= state.cleanup_deadline_ms) state.cleanup_failed = 1;
+	if (state.opened || state.opening || state.in_api || state.close_pending)
+		return 0;
+#ifdef MLINK_HIDAPI_NATIVE_CANDIDATE
+	/* A closed handle is not released native ownership. Failed or deferred
+	 * disposal must remain unresolved even when all host calls returned. */
+	if (native_prepare_attempted && state.ops != NULL) return 0;
+#endif
+	state.health_phase = MLINK_HEALTH_FINISHED;
+	return !state.cleanup_failed;
+}
+
+mlink_health_snapshot_t mlink_shared_operational_snapshot(void)
+{
+	mlink_health_snapshot_t result = {state.health_phase, state.health_reason,
+		state.cleanup_failed, state.cleanup_stop_attempted, state.publications};
+	return result;
+}
