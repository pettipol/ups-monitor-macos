+/* The guard is cooperative, not a hard deadline for blocking OS calls. Never
+ * defer release on a missed deadline; retain failure while releasing once. */
+static void mark_terminal(void)
+{
+	state.terminal = 1;
+#ifdef MLINK_HIDAPI_OPERATIONAL_V2
+	if (state.health_phase == MLINK_HEALTH_STARTING
+	 || state.health_phase == MLINK_HEALTH_ACTIVE) {
+		int64_t now;
+		state.health_phase = MLINK_HEALTH_CLEANING;
+		if (state.health_reason == MLINK_HEALTH_NONE)
+			state.health_reason = MLINK_HEALTH_IO;
+		if (state.ops == NULL || state.ops->monotonic_ms == NULL
+		 || state.ops->monotonic_ms(state.user, &now) != 0 || now < 0
+		 || (state.have_clock && now < state.last_clock_ms)
+		 || now > INT64_MAX - 2000) {
+			state.cleanup_failed = 1;
+			return;
+		}
+		state.have_clock = 1;
+		state.last_clock_ms = now;
+		state.cleanup_deadline_ms = now + 2000;
+		state.cleanup_deadline_valid = 1;
+	}
+#endif
