+/* Validate every sampled STARTING/ACTIVE time before deriving a lease result.
+ * CLEANING and later phases intentionally have no ordinary-operation deadline. */
+static int health_sample_before_deadline(int64_t now)
+{
+	if (state.health_phase != MLINK_HEALTH_STARTING
+	 && state.health_phase != MLINK_HEALTH_ACTIVE)
+		return 1;
+	if (now < state.deadline_ms)
+		return 1;
+	if (state.health_reason == MLINK_HEALTH_NONE)
+		state.health_reason = state.health_phase == MLINK_HEALTH_STARTING
+			? MLINK_HEALTH_STARTUP_DEADLINE : MLINK_HEALTH_PROGRESS_DEADLINE;
+	mark_terminal();
+	return 0;
+}
