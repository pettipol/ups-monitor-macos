+def _h12_record(workspace: Path, fired: bool, control_reason: str | None) -> None:
+    """One exclusive qualification receipt in the existing private workspace."""
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
+    root = os.open(workspace, flags)
+    try:
+        info = os.fstat(root)
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
+            raise ValueError("h12_workspace")
+        raw = (json.dumps({"schema": 1, "fired": fired, "control_reason": control_reason},
+                          sort_keys=True, separators=(",", ":")) + "\n").encode("ascii")
+        fd = os.open("h12-fuse-status.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL |
+                     os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), 0o600, dir_fd=root)
+        try:
+            view = memoryview(raw)
+            while view:
+                count = os.write(fd, view)
+                if count <= 0:
+                    raise OSError("h12_receipt_write")
+                view = view[count:]
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        os.fsync(root)
+    finally:
+        os.close(root)
+
