diff --git a/drivers/main.c b/drivers/main.c
--- a/drivers/main.c
+++ b/drivers/main.c
@@ -2169,6 +2169,42 @@
 	dstate_dump();
 	upsdebugx(1, "%s: finished driver state dump for [%s]",
 		__func__, upsname);
+}
+
+static volatile sig_atomic_t guarded_dump_signal = 0;
+
+static void guarded_dump_signal_handler(int sig)
+{
+	guarded_dump_signal = sig;
+}
+
+static int setup_guarded_dump_signals(void)
+{
+	struct sigaction sa;
+	int signals[] = {SIGTERM, SIGINT, SIGQUIT};
+	size_t i;
+
+	memset(&sa, 0, sizeof(sa));
+	if (sigemptyset(&sa.sa_mask) != 0) {
+		return -1;
+	}
+	sa.sa_handler = guarded_dump_signal_handler;
+	sa.sa_flags = 0;
+
+	for (i = 0; i < sizeof(signals) / sizeof(signals[0]); i++) {
+		if (sigaction(signals[i], &sa, NULL) != 0) {
+			return -1;
+		}
+	}
+
+	return 0;
+}
+
+static void exit_if_guarded_dump_signal_requested(void)
+{
+	if (guarded_dump_signal != 0) {
+		exit(EXIT_FAILURE);
+	}
 }
 
