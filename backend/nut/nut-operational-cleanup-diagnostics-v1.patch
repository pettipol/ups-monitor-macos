+mlink_operational_cleanup_diagnostic_t mlink_shared_operational_cleanup_diagnostic(void)
+{
+	mlink_operational_cleanup_diagnostic_t result = {0};
+	int64_t cleanup_started_ms;
+	uint64_t delta_ms;
+	result.cleanup_attempted = state.cleanup_stop_attempted != 0;
+	result.write_called = state.cleanup_callback_called != 0;
+	if (result.write_called) {
+		if (state.cleanup_callback_result < 0) {
+			result.write_kind = 1;
+			result.write_rc = -1;
+			result.write_rc_valid = 1;
+		} else if (state.cleanup_callback_result < (int)REPORT_SIZE) {
+			result.write_kind = 2;
+			result.write_rc = state.cleanup_callback_result;
+			result.write_rc_valid = 1;
+		} else if (state.cleanup_callback_result == (int)REPORT_SIZE) {
+			result.write_kind = 3;
+			result.write_rc = (int)REPORT_SIZE;
+			result.write_rc_valid = 1;
+		} else {
+			result.write_kind = 4;
+		}
+	}
+	if (!state.cleanup_deadline_valid || !state.finish_clock_valid
+	 || state.cleanup_deadline_ms < 2000
+	 || state.finish_clock_ms < state.cleanup_deadline_ms - 2000
+	 || state.finish_clock_ms < state.last_clock_ms) return result;
+	cleanup_started_ms = state.cleanup_deadline_ms - 2000;
+	delta_ms = (uint64_t)(state.finish_clock_ms - cleanup_started_ms);
+	if (delta_ms > MLINK_OPERATIONAL_MAX_ELAPSED) return result;
+	result.cleanup_delta_ms = delta_ms;
+	result.cleanup_delta_valid = 1;
+	return result;
+}
