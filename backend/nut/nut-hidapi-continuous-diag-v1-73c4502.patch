+static void microlink_diag_increment(unsigned int counter)
+{
+	if (!continuous_mode || counter >= DIAG_COUNTER_COUNT) return;
+	/* The flag means an increment was discarded, not merely that the exact
+	 * representable maximum was reached. */
+	if (continuous_diag_counters[counter] == UINT32_MAX) {
+		continuous_diag_saturated = 1;
+		return;
+	}
+	continuous_diag_counters[counter]++;
+}
+
+static uint32_t microlink_diag_time(uint64_t value)
+{
+	if (value > UINT32_MAX) {
+		continuous_diag_time_saturated = 1;
+		return UINT32_MAX;
+	}
+	return (uint32_t)value;
+}
+
+static void microlink_diag_blob_rows(unsigned int rows)
+{
+	if (!continuous_mode) return;
+	if (!continuous_diag_blob_rows_defined) {
+		continuous_diag_blob_rows_min = rows;
+		continuous_diag_blob_rows_max = rows;
+		continuous_diag_blob_rows_defined = 1;
+	} else {
+		if (rows < continuous_diag_blob_rows_min) continuous_diag_blob_rows_min = rows;
+		if (rows > continuous_diag_blob_rows_max) continuous_diag_blob_rows_max = rows;
+	}
+}
+
+static void microlink_diag_note_site(const char *site)
+{
+	if (continuous_mode && !continuous_terminal_latched
+	 && continuous_diag_first_site[0] == 'n')
+		continuous_diag_first_site = site;
+}
+
+static int microlink_diag_append(char *buffer, size_t capacity, size_t *used,
+	const char *format, ...)
+{
+	int written;
+	va_list args;
+	if (*used >= capacity) return 0;
+	va_start(args, format);
+	written = vsnprintf(buffer + *used, capacity - *used, format, args);
+	va_end(args);
+	if (written < 0 || (size_t)written >= capacity - *used) return 0;
+	*used += (size_t)written;
+	return 1;
+}
