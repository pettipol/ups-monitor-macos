--- backend/nut/cleanup_diagnostics.py
+++ runtime/cleanup_diagnostics.py
@@ -202,3 +202,212 @@
         if not consistent:
             raise _DiagnosticError("write_consistency")
         return dict(value)
+
+
+# E116 is intentionally a separate protocol. Do not fold its state or schema
+# into the existing cleanup-v1 parser above.
+FIRST_IO_PREFIX = b"UPS_FIRST_IO_TRANSITION_V1 "
+FIRST_IO_MAX_RECORD_BYTES = 512
+FIRST_IO_MAX_SAFE_INTEGER = 9_007_199_254_740_991
+FIRST_IO_MIN_INT64 = -(1 << 63)
+FIRST_IO_MAX_INT64 = (1 << 63) - 1
+_FIRST_IO_KEYS = frozenset({
+    "v", "site", "phase", "actual", "expected", "last_stop", "last_elapsed_ms",
+})
+_FIRST_IO_NULL_COUNT_SITES = frozenset({1, 2, 3, 7, 8, 9, 12, 13, 14, 15, 16})
+_FIRST_IO_WHITESPACE = frozenset(b" \t\r\n\v\f")
+
+
+class _FirstIOError(ValueError):
+    def __init__(self, code: str):
+        self.code = code
+
+
+class FirstIOTransitionParser:
+    """Boundedly parse at most one E116 diagnostic from stderr chunks."""
+
+    def __init__(self) -> None:
+        self._prefix_position = 0
+        self._candidate = False
+        self._discard_until_lf = False
+        self._buffer = bytearray()
+        self._seen_candidate = False
+        self._invalid_code: str | None = None
+        self._incomplete_code: str | None = None
+        self._diagnostic: dict | None = None
+
+    def accept(self, chunk: bytes) -> None:
+        if type(chunk) is not bytes:
+            self._invalidate("shape")
+            return
+        if self._invalid_code is not None:
+            return
+        for byte in chunk:
+            if self._discard_until_lf:
+                if byte == 10:
+                    self._end_line()
+                continue
+            if not self._candidate:
+                if byte == FIRST_IO_PREFIX[self._prefix_position]:
+                    self._prefix_position += 1
+                    if self._prefix_position == len(FIRST_IO_PREFIX):
+                        self._prefix_position = 0
+                        if self._seen_candidate:
+                            self._invalidate("duplicate_record")
+                            self._discard_until_lf = True
+                        else:
+                            self._seen_candidate = True
+                            self._candidate = True
+                            self._buffer.extend(FIRST_IO_PREFIX)
+                    continue
+                self._prefix_position = 0
+                if byte == 10:
+                    self._end_line()
+                else:
+                    self._discard_until_lf = True
+                continue
+
+            self._buffer.append(byte)
+            if byte == 10:
+                self._finish_candidate()
+                self._end_line()
+                if self._invalid_code is not None:
+                    return
+                continue
+            if byte > 0x7F:
+                self._invalidate("non_ascii")
+                self._discard_until_lf = True
+                continue
+            if byte in _FIRST_IO_WHITESPACE or byte == 0x5C:
+                self._invalidate("shape")
+                self._discard_until_lf = True
+                continue
+            # The LF is part of the 512-byte wire bound.
+            if len(self._buffer) >= FIRST_IO_MAX_RECORD_BYTES:
+                self._invalidate("overlong")
+                self._discard_until_lf = True
+
+    def snapshot(self, stream_complete: bool) -> dict:
+        if self._invalid_code is not None:
+            return {"state": "invalid", "error_code": self._invalid_code, "diagnostic": None}
+        if type(stream_complete) is not bool:
+            return {"state": "invalid", "error_code": "shape", "diagnostic": None}
+        if not stream_complete:
+            return {"state": "incomplete", "error_code": "stream_not_final", "diagnostic": None}
+        if self._candidate or self._prefix_position:
+            self._incomplete_code = "truncated"
+            self._buffer.clear()
+            self._candidate = False
+            self._prefix_position = 0
+            self._discard_until_lf = False
+            return {"state": "incomplete", "error_code": "truncated", "diagnostic": None}
+        if self._incomplete_code is not None:
+            return {"state": "incomplete", "error_code": self._incomplete_code,
+                    "diagnostic": None}
+        if self._seen_candidate and self._diagnostic is not None:
+            return {"state": "valid", "error_code": None, "diagnostic": dict(self._diagnostic)}
+        return {"state": "absent", "error_code": None, "diagnostic": None}
+
+    def _end_line(self) -> None:
+        self._prefix_position = 0
+        self._candidate = False
+        self._discard_until_lf = False
+        self._buffer.clear()
+
+    def _finish_candidate(self) -> None:
+        try:
+            self._diagnostic = self._decode_record(bytes(self._buffer))
+        except _FirstIOError as error:
+            self._invalidate(error.code)
+        except RecursionError:
+            self._invalidate("shape")
+        except (UnicodeError, ValueError, TypeError, json.JSONDecodeError):
+            self._invalidate("shape")
+
+    def _invalidate(self, code: str) -> None:
+        if self._invalid_code is None:
+            self._invalid_code = code
+        self._diagnostic = None
+        self._buffer.clear()
+
+    @staticmethod
+    def _decode_record(record: bytes) -> dict:
+        if len(record) > FIRST_IO_MAX_RECORD_BYTES or not record.endswith(b"\n"):
+            raise _FirstIOError("overlong" if len(record) > FIRST_IO_MAX_RECORD_BYTES else "truncated")
+        payload_bytes = record[len(FIRST_IO_PREFIX):-1]
+        if any(byte > 0x7F for byte in payload_bytes):
+            raise _FirstIOError("non_ascii")
+        if any(byte in _FIRST_IO_WHITESPACE or byte == 0x5C for byte in payload_bytes):
+            raise _FirstIOError("shape")
+
+        def parse_integer(token: str) -> int:
+            if len(token.lstrip("-")) > 19:
+                raise _FirstIOError("range")
+            return int(token, 10)
+
+        def reject_float(_token: str):
+            raise _FirstIOError("shape")
+
+        def reject_constant(_token: str):
+            raise _FirstIOError("shape")
+
+        def unique_object(pairs: list[tuple[str, object]]) -> dict:
+            value = {}
+            for key, item in pairs:
+                if key in value:
+                    raise _FirstIOError("duplicate_key")
+                value[key] = item
+            return value
+
+        value = json.loads(payload_bytes.decode("ascii"), object_pairs_hook=unique_object,
+                           parse_int=parse_integer, parse_float=reject_float,
+                           parse_constant=reject_constant)
+        if type(value) is not dict or set(value) != _FIRST_IO_KEYS:
+            raise _FirstIOError("shape")
+        if type(value["v"]) is not int or value["v"] != 1:
+            raise _FirstIOError("range" if type(value["v"]) is int else "shape")
+        site = value["site"]
+        if type(site) is not int or not 1 <= site <= 16:
+            raise _FirstIOError("range" if type(site) is int else "shape")
+        phase = value["phase"]
+        if type(phase) is not int or not 0 <= phase <= 4:
+            raise _FirstIOError("range" if type(phase) is int else "shape")
+
+        actual, expected = value["actual"], value["expected"]
+        if actual is None or expected is None:
+            if actual is not None or expected is not None:
+                raise _FirstIOError("site_counts")
+        elif (type(actual) is not int or type(expected) is not int
+              or not FIRST_IO_MIN_INT64 <= actual <= FIRST_IO_MAX_INT64
+              or not FIRST_IO_MIN_INT64 <= expected <= FIRST_IO_MAX_INT64):
+            raise _FirstIOError("range" if type(actual) is int and type(expected) is int else "shape")
+
+        last_stop = value["last_stop"]
+        if last_stop is not None and (type(last_stop) is not int or last_stop not in (0, 1)):
+            raise _FirstIOError("range" if type(last_stop) is int else "shape")
+        last_elapsed = value["last_elapsed_ms"]
+        if last_elapsed is not None and (type(last_elapsed) is not int
+                or not 0 <= last_elapsed <= FIRST_IO_MAX_SAFE_INTEGER):
+            raise _FirstIOError("range" if type(last_elapsed) is int else "shape")
+
+        if site in _FIRST_IO_NULL_COUNT_SITES:
+            if actual is not None:
+                raise _FirstIOError("site_counts")
+        elif site == 4:
+            if actual is None or actual >= 0 or expected != 0:
+                raise _FirstIOError("site_counts")
+        elif site == 5:
+            if actual is None or actual <= 65 or expected != 65:
+                raise _FirstIOError("site_counts")
+        elif site == 6:
+            if actual is None or actual not in (*range(1, 64), 65) or expected != 64:
+                raise _FirstIOError("site_counts")
+        elif site == 10:
+            if actual is None or actual in (64, -2) or expected != 64:
+                raise _FirstIOError("site_counts")
+        elif site == 11:
+            if actual != -2 or expected != 64:
+                raise _FirstIOError("site_counts")
+        if site == 1 and last_stop != 1:
+            raise _FirstIOError("site_last_stop")
+        return dict(value)
