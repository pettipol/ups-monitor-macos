+static void microlink_operational_emit_first_io(mlink_first_io_transition_t diagnostic)
+{
+	char line[513U];
+	char actual[32U] = "null";
+	char expected[32U] = "null";
+	char last_elapsed[32U] = "null";
+	const char *last_stop = diagnostic.last_stop_valid
+		? (diagnostic.last_stop ? "1" : "0") : "null";
+	int written;
+	if (diagnostic.site == MLINK_FIRST_IO_NONE) return;
+	if (diagnostic.counts_valid) {
+		written = snprintf(actual, sizeof(actual), "%" PRId64, diagnostic.actual);
+		if (written < 0 || (size_t)written >= sizeof(actual)) return;
+		written = snprintf(expected, sizeof(expected), "%" PRId64, diagnostic.expected);
+		if (written < 0 || (size_t)written >= sizeof(expected)) return;
+	}
+	if (diagnostic.last_elapsed_valid) {
+		written = snprintf(last_elapsed, sizeof(last_elapsed), "%" PRIu64,
+			diagnostic.last_elapsed_ms);
+		if (written < 0 || (size_t)written >= sizeof(last_elapsed)) return;
+	}
+	written = snprintf(line, sizeof(line),
+		"UPS_FIRST_IO_TRANSITION_V1 {\"v\":1,\"site\":%d,\"phase\":%d,"
+		"\"actual\":%s,\"expected\":%s,\"last_stop\":%s,\"last_elapsed_ms\":%s}\n",
+		(int)diagnostic.site, (int)diagnostic.phase, actual, expected, last_stop, last_elapsed);
+	if (written < 0 || (size_t)written >= sizeof(line)) return;
+	/* Cleanup is already one-shot. Diagnostic delivery is best effort and
+	 * does not participate in the driver result or ownership. */
+	(void)fwrite(line, 1U, (size_t)written, stderr);
+}
