@@ -0,0 +1,305 @@
+/* Fake-only whole-driver replay host. Never linked into a native candidate. */
+#include "apcmicrolink-hidapi-native.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+typedef struct replay_host {
+	int64_t now_ms;
+	unsigned int init_calls;
+	unsigned int select_calls;
+	unsigned int open_calls;
+	unsigned int close_calls;
+	unsigned int dispose_calls;
+	unsigned int read_calls;
+	unsigned int wait_calls;
+	unsigned int stop_writes;
+	unsigned int init_writes;
+	unsigned int next_writes;
+	unsigned int other_writes;
+	int close_fails;
+	int report_pending;
+	unsigned char report[64];
+} replay_host_t;
+
+static replay_host_t host;
+
+static void report_counters(void)
+{
+	fprintf(stderr,
+		"FAKE_COUNTERS init=%u select=%u open=%u close=%u dispose=%u "
+			"read=%u wait=%u stop=%u init_byte=%u next=%u other_write=%u now_ms=%lld\n",
+		host.init_calls, host.select_calls, host.open_calls, host.close_calls,
+		host.dispose_calls, host.read_calls, host.wait_calls, host.stop_writes, host.init_writes,
+		host.next_writes, host.other_writes, (long long)host.now_ms);
+}
+
+static int fake_ok(void *user)
+{
+	(void)user;
+	return 0;
+}
+
+static int fake_init(void *user)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	state->init_calls++;
+	return 0;
+}
+
+static int fake_select_unique(void *user, unsigned int *selected_count)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	state->select_calls++;
+	*selected_count = 1U;
+	return 0;
+}
+
+static int fake_open(void *user)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	state->open_calls++;
+	return 0;
+}
+
+static int fake_layout(void *user, mlink_shared_layout_t *layout)
+{
+	(void)user;
+	memset(layout, 0, sizeof(*layout));
+	layout->selected_count = 1U;
+	layout->input_report_id = 1U;
+	layout->output_report_id = 2U;
+	layout->input_direction = MLINK_SHARED_INPUT;
+	layout->output_direction = MLINK_SHARED_OUTPUT;
+	layout->input_report_length = 64U;
+	layout->output_report_length = 64U;
+	return 0;
+}
+
+static void queue_page(replay_host_t *state, unsigned char id,
+	const unsigned char data[48])
+{
+	unsigned char frame[51] = {0};
+	unsigned int c0 = 0, c1 = 0;
+	size_t i;
+	frame[0] = id;
+	memcpy(frame + 1U, data, 48U);
+	for (i = 0; i < 49U; i++) {
+		c0 = (c0 + frame[i]) % 255U;
+		c1 = (c1 + c0) % 255U;
+	}
+	frame[49] = (unsigned char)(255U - ((c0 + c1) % 255U));
+	frame[50] = (unsigned char)(255U - ((c0 + frame[49]) % 255U));
+	memset(state->report, 0, sizeof(state->report));
+	state->report[0] = 1U; /* input report ID */
+	memcpy(state->report + 1U, frame, sizeof(frame));
+	state->report_pending = 1;
+}
+
+static void queue_protocol_page(replay_host_t *state, unsigned char flags)
+{
+	unsigned char data[48] = {0};
+	const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+	data[0] = 1U;  /* protocol version */
+	data[1] = 48U; /* data width */
+	data[2] = 3U;  /* page count */
+	data[3] = 0U;
+	data[4] = 1U;  /* series ID */
+	data[5] = 1U;  /* series data version */
+	data[6] = flags; /* descriptor present, no authentication */
+	data[8] = 1U;  /* descriptor version */
+	data[10] = 1U; /* descriptor data pointer: page 1, offset 0 */
+	data[11] = 0U;
+	{
+		static const unsigned char definition[] = {
+			0xF8U, 2U, 0xFEU, 4U, 0x0AU, 0xFEU, 5U,
+			0x20U, 0x9FU, 0x21U, 0x22U, 0xFFU, 0xFEU, 6U,
+			0x25U, 0x27U, 0xFFU, 0xFEU, 7U, 0x25U, 0x26U, 0x27U,
+			0x28U, 0x2AU, 0x2BU, 0x49U, 0xFFU, 0xFFU, 0xFFU, 0xFFU
+		};
+		memcpy(data + 12U, definition, sizeof(definition));
+	}
+	if (scenario != NULL && strcmp(scenario, "bad-descriptor") == 0)
+		data[12U] = 0U;
+	queue_page(state, 0U, data);
+}
+
+static void queue_measurement_page(replay_host_t *state)
+{
+	unsigned char data[48] = {0};
+	static const unsigned char values[] = {
+		0x00U, 0x02U, /* ups.status OL */
+		0x64U, 0x00U, /* battery.charge = 50 percent */
+		0x0EU, 0x10U, /* battery.runtime = 3600 seconds */
+		0x01U, 0x80U, /* battery.voltage = 12 V */
+		0x0CU, 0x80U, /* temperature = 25 C */
+		0x1EU, 0x00U, /* input.voltage = 120 V */
+		0x1EU, 0x00U, /* input.frequency = 60 Hz */
+		0x1EU, 0x00U, /* output.voltage = 120 V */
+		0x00U, 0xA0U, /* output.current = 5 A */
+		0x1EU, 0x00U, /* output.frequency = 60 Hz */
+		0x12U, 0xCCU, /* ups.load = 18.796875 percent */
+		0x03U, 0x84U, /* real power nominal = 900 W */
+		0x04U, 0xB0U, /* power nominal = 1200 VA */
+		0x16U, 0x39U  /* apparent load = 22.22265625 percent */
+	};
+	memcpy(data, values, sizeof(values));
+	queue_page(state, 1U, data);
+}
+
+static void queue_unrelated_page(replay_host_t *state)
+{
+	unsigned char data[48] = {0};
+	memset(data, 0x5a, sizeof(data));
+	queue_page(state, 2U, data);
+}
+
+static ssize_t fake_read(void *user, unsigned char *dst, size_t capacity,
+	unsigned int timeout_ms)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	(void)timeout_ms;
+	state->read_calls++;
+	if (!state->report_pending) {
+		const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+		if (scenario != NULL && strcmp(scenario, "silent") == 0)
+			state->now_ms += 1000;
+		return 0;
+	}
+	if (capacity < sizeof(state->report)) return -1;
+	{
+		const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+		if (scenario != NULL && strcmp(scenario, "late-page") == 0
+		 && state->read_calls == 4U) {
+			state->now_ms += 120000;
+		}
+	}
+	memcpy(dst, state->report, sizeof(state->report));
+	state->report_pending = 0;
+	return (ssize_t)sizeof(state->report);
+}
+
+static ssize_t fake_write(void *user, const unsigned char *src, size_t length)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	unsigned char command;
+	if (length != 64U || src[0] != 2U) return -1;
+	command = src[1];
+	switch (command) {
+	case 0xF7U: state->stop_writes++; break;
+	case 0xFDU: state->init_writes++; queue_protocol_page(state, 0x08U); break;
+	case 0xFEU:
+		state->next_writes++;
+		if (getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO") != NULL
+		 && strcmp(getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO"), "silent") == 0
+		 && state->next_writes > 3U) {
+			fprintf(stderr, "SILENT_NEXT at_ms=%lld\n", (long long)state->now_ms);
+			break;
+		}
+		if (state->next_writes == 1U) {
+			queue_measurement_page(state);
+		} else if (state->next_writes == 2U) {
+			queue_unrelated_page(state);
+		} else {
+			const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+			if (scenario != NULL && strcmp(scenario, "mutate-geometry") == 0
+			 && state->next_writes == 3U)
+				queue_protocol_page(state, 0U);
+			else if (scenario != NULL && strcmp(scenario, "unrelated-refresh") == 0)
+				queue_unrelated_page(state);
+			else
+				queue_measurement_page(state);
+		}
+		break;
+	default: state->other_writes++; break;
+	}
+	return (ssize_t)length;
+}
+
+static int fake_close(void *user)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+	state->close_calls++;
+	if (scenario != NULL && strcmp(scenario, "slow-close") == 0)
+		state->now_ms += 20000;
+	state->close_fails = scenario != NULL && strcmp(scenario, "close-fails") == 0;
+	return state->close_fails ? -1 : 0;
+}
+
+static int fake_stopped(void *user)
+{
+	(void)user;
+	return 0;
+}
+
+static int fake_clock(void *user, int64_t *now_ms)
+{
+	replay_host_t *state = (replay_host_t *)user;
+	*now_ms = state->now_ms;
+	return 0;
+}
+
+static const mlink_shared_host_ops_t fake_ops = {
+	fake_init, fake_ok, fake_select_unique, fake_open, fake_layout,
+	fake_read, fake_write, fake_close, fake_stopped, fake_clock, NULL
+};
+
+int mlink_hidapi_native_create(const mlink_hidapi_native_config_t *config,
+	mlink_hidapi_native_binding_t *binding)
+{
+	if (config == NULL || binding == NULL || binding->ops != NULL) return -1;
+	if (atexit(report_counters) != 0) return -1;
+	binding->ops = &fake_ops;
+	binding->user = &host;
+	return 0;
+}
+
+int mlink_hidapi_native_dispose(mlink_hidapi_native_binding_t *binding)
+{
+	if (binding == NULL || binding->ops != &fake_ops || binding->user != &host
+	 || host.close_fails) return -1;
+	host.dispose_calls++;
+	memset(binding, 0, sizeof(*binding));
+	return 0;
+}
+
+int mlink_hidapi_native_post_finish_clock_ms(int64_t *now_ms)
+{
+	if (now_ms == NULL) return -1;
+	*now_ms = host.now_ms;
+	return 0;
+}
+
+int mlink_continuous_replay_wait(unsigned int wait_ms)
+{
+	const char *scenario = getenv("MLINK_CONTINUOUS_REPLAY_SCENARIO");
+	if (wait_ms > 100U) return 0;
+	host.wait_calls++;
+	if (scenario != NULL && strcmp(scenario, "missed-slots") == 0
+	 && host.wait_calls == 1U) {
+		host.now_ms += 15000;
+		return 1;
+	}
+	host.now_ms += (int64_t)wait_ms;
+	return 1;
+}
+
+time_t time(time_t *result)
+{
+	time_t value = (time_t)(1000000 + host.now_ms / 1000);
+	if (result != NULL) *result = value;
+	return value;
+}
+
+int clock_gettime(clockid_t clock_id, struct timespec *value)
+{
+	int64_t ms = host.now_ms;
+	(void)clock_id;
+	if (value == NULL || ms < 0) return -1;
+	value->tv_sec = (time_t)(1000000 + ms / 1000);
+	value->tv_nsec = (long)(ms % 1000) * 1000000L;
+	return 0;
+}
diff --git a/tests/test_replay_continuous.py b/tests/test_replay_continuous.py
--- a/tests/test_replay_continuous.py
+++ b/tests/test_replay_continuous.py
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Whole-NUT main/driver replay against the fake-only native host."""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+FIELD_KINDS = {
+    "ups.status": "reported",
+    "battery.charge": "reported",
+    "battery.runtime": "reported",
+    "battery.voltage": "reported",
+    "battery.temperature": "reported",
+    "ups.temperature": "reported",
+    "input.voltage": "reported",
+    "input.frequency": "reported",
+    "output.voltage": "reported",
+    "output.current": "reported",
+    "output.frequency": "reported",
+    "ups.load": "reported",
+    "experimental.ups.load.apparent": "reported",
+    "ups.realpower.nominal": "static",
+    "ups.power.nominal": "static",
+    "ups.realpower": "driverDerived",
+    "ups.power": "driverDerived",
+}
+EXPECTED_NUMBERS = {
+    "battery.charge": 50.0,
+    "battery.runtime": 3600.0,
+    "battery.voltage": 12.0,
+    "battery.temperature": 25.0,
+    "ups.temperature": 25.0,
+    "input.voltage": 120.0,
+    "input.frequency": 60.0,
+    "output.voltage": 120.0,
+    "output.current": 5.0,
+    "output.frequency": 60.0,
+    "ups.load": 18.796875,
+    "experimental.ups.load.apparent": 22.22265625,
+    "ups.realpower.nominal": 900.0,
+    "ups.power.nominal": 1200.0,
+    "ups.realpower": 169.171875,
+}
+ENVELOPE = {"protocol", "schema_version", "type", "sequence", "slot", "elapsed_ms", "missed_slots", "fields"}
+
+
+def reject_duplicates(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise AssertionError(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def reject_constant(value: str) -> None:
+    raise AssertionError(f"non-finite JSON number: {value}")
+
+
+def parse_case(binary: Path, scenario: str | None) -> tuple[int, list[dict[str, object]], str]:
+    env = os.environ.copy()
+    env.pop("MLINK_CONTINUOUS_REPLAY_SCENARIO", None)
+    if scenario:
+        env["MLINK_CONTINUOUS_REPLAY_SCENARIO"] = scenario
+    proc = subprocess.run(
+        [
+            str(binary), "-s", "replay", "-d1",
+            "-x", "port=auto", "-x", "hidapi_shared", "-x", "guarded_monitor",
+            "-x", "guard_vid=0001", "-x", "guard_pid=0002",
+            "-x", "guard_deadline=130", "-x", "guard_probe_attempts=1",
+            "-x", "hid_fallback=no", "-x", "monitor_stream_v1",
+        ],
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        timeout=20,
+        env=env,
+        check=False,
+    )
+    assert not proc.stdout or proc.stdout.endswith("\n")
+    lines = proc.stdout.splitlines()
+    records = [
+        json.loads(line, object_pairs_hook=reject_duplicates, parse_constant=reject_constant)
+        for line in lines
+    ]
+    assert all(len(line.encode("utf-8")) <= 8192 for line in lines)
+    assert "Network UPS Tools" not in proc.stdout
+    return proc.returncode, records, proc.stderr
+
+
+def counters(stderr: str) -> dict[str, int]:
+    match = re.search(r"^FAKE_COUNTERS (.+)$", stderr, re.MULTILINE)
+    assert match, stderr
+    return {key: int(value) for key, value in re.findall(r"([a-z_]+)=(-?[0-9]+)", match.group(1))}
+
+
+def assert_sample(record: dict[str, object]) -> None:
+    assert set(record) == ENVELOPE
+    assert record["protocol"] == "ups-monitor.continuous.v1"
+    assert record["schema_version"] == 1
+    assert record["type"] == "sample"
+    fields = record["fields"]
+    assert isinstance(fields, dict) and set(fields) == set(FIELD_KINDS)
+    for name, field in fields.items():
+        assert isinstance(field, dict)
+        assert set(field) == {"value", "observed_ms", "kind", "state"}
+        assert field["kind"] == FIELD_KINDS[name]
+        if field["state"] == "unavailable":
+            assert field["value"] is None and field["observed_ms"] is None
+        assert field["state"] == "observed", (name, field)
+        assert isinstance(field["observed_ms"], int)
+        assert field["observed_ms"] <= record["elapsed_ms"]
+    assert fields["ups.status"]["value"] == "OL"
+    for name, expected in EXPECTED_NUMBERS.items():
+        value = fields[name]["value"]
+        assert isinstance(value, str) and math.isclose(
+            float(value), expected, rel_tol=1e-9, abs_tol=1e-6
+        ), (name, value, expected)
+    for percent_name, nominal_name, target_name in (
+        ("ups.load", "ups.realpower.nominal", "ups.realpower"),
+        ("experimental.ups.load.apparent", "ups.power.nominal", "ups.power"),
+    ):
+        expected = float(fields[percent_name]["value"]) * float(
+            fields[nominal_name]["value"]
+        ) / 100.0
+        actual = float(fields[target_name]["value"])
+        assert math.isclose(actual, expected, rel_tol=1e-12, abs_tol=1e-9), (
+            target_name, actual, expected
+        )
+    assert fields["battery.temperature"] == fields["ups.temperature"]
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: test_replay_continuous.py FAKE_REPLAY_BINARY")
+    binary = Path(sys.argv[1]).resolve()
+    assert binary.is_file() and os.access(binary, os.X_OK)
+
+    rc, records, stderr = parse_case(binary, None)
+    assert rc == 0, stderr
+    assert len(records) == 25
+    samples = records[:-1]
+    end = records[-1]
+    assert [record["slot"] for record in samples] == list(range(24))
+    assert [record["sequence"] for record in samples] == list(range(1, 25))
+    assert [record["missed_slots"] for record in samples] == [0] * 24
+    all_sample_times = [record["elapsed_ms"] for record in samples]
+    assert all(isinstance(value, int) and value < 120000 for value in all_sample_times)
+    for record in samples:
+        assert_sample(record)
+    assert set(end) == {"protocol", "schema_version", "type", "elapsed_ms", "reason"}
+    assert end["type"] == "end" and end["elapsed_ms"] == 120000
+    assert end["reason"] == "duration_complete"
+    ordinary = counters(stderr)
+    assert ordinary["init"] == ordinary["select"] == ordinary["open"] == 1
+    assert ordinary["close"] == ordinary["dispose"] == 1
+    assert ordinary["init_byte"] == 1 and ordinary["stop"] == 2
+    assert ordinary["other_write"] == 0 and ordinary["next"] > 0
+
+    rc, records, stderr = parse_case(binary, "missed-slots")
+    assert rc == 0, stderr
+    samples, end = records[:-1], records[-1]
+    assert samples[0]["slot"] == 0 and samples[0]["missed_slots"] == 0
+    assert samples[1]["slot"] == 3 and samples[1]["sequence"] == 2
+    assert samples[1]["missed_slots"] == 2
+    assert end["elapsed_ms"] == 120000 and end["reason"] == "duration_complete"
+    missed = counters(stderr)
+    assert missed["open"] == missed["init_byte"] == 1
+
+    rc, records, stderr = parse_case(binary, "late-page")
+    assert rc == 0, stderr
+    samples, end = records[:-1], records[-1]
+    assert len(samples) == 1 and samples[0]["slot"] == 0
+    assert end["elapsed_ms"] == 125000 and end["reason"] == "duration_complete"
+    late = counters(stderr)
+    assert late["open"] == late["init_byte"] == late["close"] == late["dispose"] == 1
+    assert late["next"] >= 3 and late["other_write"] == 0
+
+    rc, records, stderr = parse_case(binary, "unrelated-refresh")
+    assert rc == 0, stderr
+    samples, end = records[:-1], records[-1]
+    assert len(samples) == 24 and end["elapsed_ms"] == 120000
+    assert_sample(samples[0])
+    assert_sample(samples[1])
+    assert all(field["observed_ms"] == 0 for field in samples[1]["fields"].values())
+    unrelated = counters(stderr)
+    assert unrelated["open"] == unrelated["init_byte"] == 1
+    assert unrelated["next"] > 3 and unrelated["other_write"] == 0
+
+    rc, records, stderr = parse_case(binary, "mutate-geometry")
+    assert rc != 0, stderr
+    samples, end = records[:-1], records[-1]
+    assert len(samples) == 1 and samples[0]["slot"] == 0
+    assert end["reason"] == "guard_error"
+    changed = counters(stderr)
+    assert changed["open"] == changed["init_byte"] == changed["close"] == changed["dispose"] == 1
+    assert changed["next"] == 3 and changed["other_write"] == 0
+
+    rc, records, stderr = parse_case(binary, "close-fails")
+    assert rc != 0, stderr
+    assert records[-1]["type"] == "end" and records[-1]["reason"] == "guard_error"
+    retained = counters(stderr)
+    assert retained["close"] == 1 and retained["dispose"] == 0
+
+    rc, records, stderr = parse_case(binary, "bad-descriptor")
+    assert rc != 0, stderr
+    assert records == [], records
+    rejected = counters(stderr)
+    assert rejected["open"] == rejected["init_byte"] == rejected["close"] == 1
+    assert rejected["dispose"] == 1 and rejected["other_write"] == 0
+
+    print("whole NUT fake replay: telemetry, scheduling, cutoff, geometry, parse and cleanup passed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
