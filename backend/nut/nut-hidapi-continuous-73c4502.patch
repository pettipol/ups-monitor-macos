+			mlink_continuous_field_invalid(field, MLINK_CONTINUOUS_REPORTED);
+			return;
+		}
+		used += (size_t)n;
+	}
+	if (count == 0U) {
+		mlink_continuous_field_unavailable(field, MLINK_CONTINUOUS_REPORTED);
+		return;
+	}
+	if (!mlink_continuous_status_valid(value)) {
+		mlink_continuous_field_invalid(field, MLINK_CONTINUOUS_REPORTED);
+		return;
+	}
