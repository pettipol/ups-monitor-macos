+static void microlink_continuous_capture_derived_one(int percent_index,
+	int nominal_index, int target_index)
+{
+	mlink_continuous_field_t *percent = &continuous_fields[percent_index];
+	mlink_continuous_field_t *nominal = &continuous_fields[nominal_index];
+	mlink_continuous_field_t *target = &continuous_fields[target_index];
+	locale_t c_locale;
+	char *end;
+	double percent_value, nominal_value, derived_value;
+	char wire_value[MLINK_CONTINUOUS_MAX_VALUE + 1U];
+	if (percent->state != MLINK_CONTINUOUS_OBSERVED
+	 || nominal->state != MLINK_CONTINUOUS_OBSERVED
+	 || nominal->kind != MLINK_CONTINUOUS_STATIC
+	 || !mlink_continuous_number_valid(percent->value)
+	 || !mlink_continuous_number_valid(nominal->value)) {
+		mlink_continuous_field_unavailable(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	c_locale = newlocale(LC_NUMERIC_MASK, "C", (locale_t)0);
+	if (c_locale == (locale_t)0) {
+		mlink_continuous_field_invalid(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	percent_value = strtod_l(percent->value, &end, c_locale);
+	if (end == percent->value || *end != '\0') {
+		freelocale(c_locale);
+		mlink_continuous_field_invalid(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	nominal_value = strtod_l(nominal->value, &end, c_locale);
+	if (end == nominal->value || *end != '\0') {
+		freelocale(c_locale);
+		mlink_continuous_field_invalid(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	freelocale(c_locale);
+	if (!isfinite(percent_value) || percent_value < 0.0 || percent_value > 100.0
+	 || !isfinite(nominal_value) || nominal_value <= 0.0) {
+		mlink_continuous_field_unavailable(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	derived_value = percent_value * nominal_value / 100.0;
+	if (!isfinite(derived_value)
+	 || snprintf(wire_value, sizeof(wire_value), "%.17g", derived_value) < 0
+	 || !mlink_continuous_number_valid(wire_value)) {
+		mlink_continuous_field_invalid(target, MLINK_CONTINUOUS_DRIVER_DERIVED);
+		return;
+	}
+	(void)mlink_continuous_field_observed(target, MLINK_CONTINUOUS_DRIVER_DERIVED,
+		wire_value, percent->observed_ms);
+}
