+int mlink_hidapi_native_post_finish_clock_ms(int64_t *now_ms)
+{
+	struct timespec now;
+	if (now_ms == NULL || clock_gettime(CLOCK_MONOTONIC, &now) != 0
+	 || now.tv_sec < 0 || now.tv_nsec < 0 || now.tv_nsec >= 1000000000L
+	 || (uintmax_t)now.tv_sec > (uintmax_t)INT64_MAX / 1000U
+	 || (int64_t)now.tv_sec * 1000 > INT64_MAX - now.tv_nsec / 1000000L) return -1;
+	*now_ms = (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000L;
+	return 0;
+}
