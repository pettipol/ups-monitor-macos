+	primary = microlink_find_descriptor_usage_validated("2:4.A");
+	if (primary == NULL || !microlink_get_descriptor_map_bits("2:4.A", &raw)
+	 || !mlink_continuous_page_dependency(continuous_blob_pages, page0.count,
+		page0.width, descriptor_blob_len, primary->data_offset, primary->size,
+		&oldest)) {
+		mlink_continuous_field_unavailable(field, MLINK_CONTINUOUS_REPORTED);
+		return;
+	}
+	calibration = microlink_find_descriptor_usage("2:13");
+	if (calibration != NULL) {
+		if (calibration->skipped
+		 || !mlink_continuous_page_dependency(continuous_blob_pages, page0.count,
+			page0.width, descriptor_blob_len, calibration->data_offset,
+			calibration->size, &observed_ms)) {
+			mlink_continuous_field_unavailable(field, MLINK_CONTINUOUS_REPORTED);
+			return;
+		}
+		if (observed_ms < oldest) oldest = observed_ms;
+	}
+	if (oldest > 119999U || status == NULL) {
+		mlink_continuous_field_unavailable(field, MLINK_CONTINUOUS_REPORTED);
+		return;
+	}
+	while (*status != '\0') {
+		const char *start;
+		size_t length;
+		while (*status == ' ') status++;
+		if (*status == '\0') break;
