+	continuous_last_slot = slot;
+	continuous_have_slot = 1;
+	return 1;
+}
+
+static int microlink_continuous_wait_until(uint64_t target_ms)
+{
+	uint64_t elapsed_ms;
+	struct timeval wait_time;
+	uint64_t wait_ms;
+	if (!microlink_usb_guard_elapsed_ms(&elapsed_ms)) return 0;
+	if (elapsed_ms >= target_ms) return 1;
+	wait_ms = target_ms - elapsed_ms;
+	if (wait_ms > 100U) wait_ms = 100U;
+	wait_time.tv_sec = (time_t)(wait_ms / 1000U);
+	wait_time.tv_usec = (suseconds_t)((wait_ms % 1000U) * 1000U);
+#ifdef MLINK_HIDAPI_CONTINUOUS_REPLAY
+	{
+		extern int mlink_continuous_replay_wait(unsigned int wait_ms);
+		if (!mlink_continuous_replay_wait((unsigned int)wait_ms)) return 0;
+	}
+#else
+	if (select(0, NULL, NULL, NULL, &wait_time) < 0 && errno != EINTR) return 0;
+#endif
+	return 1;
+}
+
+int apcmicrolink_continuous_stream_v1_run(void)
+{
+	uint64_t elapsed_ms = 0;
+	uint64_t next_slot_ms;
+	char line[MLINK_CONTINUOUS_MAX_LINE + 1U];
+	int output_ok = 1;
+	int cleanup_ok;
+	int result = 1;
+	if (!continuous_mode) return 1;
+	for (;;) {
+		uint32_t due_slot;
+		if (continuous_terminal_latched) break;
+		if (microlink_guarded_stop_requested()) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_CANCELLED);
+			break;
+		}
+		if (!microlink_usb_guard_elapsed_ms(&elapsed_ms)) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+			break;
+		}
+		continuous_last_elapsed_ms = elapsed_ms;
+		if (elapsed_ms >= 120000U) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_DURATION_COMPLETE);
+			break;
+		}
+		if (microlink_usb_guard_expired()) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+			break;
+		}
+		if (microlink_usb_device_gone()) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_DEVICE_LOST);
+			break;
+		}
+		if (!session_ready || continuous_guard_error) {
+			microlink_continuous_latch_end(continuous_guard_error
+				? MLINK_CONTINUOUS_END_GUARD_ERROR : MLINK_CONTINUOUS_END_SESSION_LOST);
+			break;
+		}
+		due_slot = (uint32_t)(elapsed_ms / 5000U);
+		if (!continuous_have_slot || due_slot > continuous_last_slot) {
+			if (continuous_sequence != 0U) {
+				upsdrv_updateinfo();
+				if (continuous_terminal_latched) break;
+				upsdebugx(1, "apcmicrolink: continuous update complete elapsed=%" PRIu64 " guard=%d session=%d",
+					elapsed_ms, continuous_guard_error, session_ready);
+				if (!microlink_usb_guard_elapsed_ms(&elapsed_ms)) {
+					microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+					break;
+				}
+				continuous_last_elapsed_ms = elapsed_ms;
+				if (elapsed_ms >= 120000U) {
+					microlink_continuous_latch_end(MLINK_CONTINUOUS_END_DURATION_COMPLETE);
+					break;
+				}
+				if (continuous_guard_error || !session_ready) break;
+				if (microlink_guarded_stop_requested()) {
+					microlink_continuous_latch_end(MLINK_CONTINUOUS_END_CANCELLED);
+					break;
+				}
+			}
+			if (!microlink_continuous_emit_sample(elapsed_ms)) {
+				if (continuous_end_reason != MLINK_CONTINUOUS_END_OUTPUT_ERROR)
+					microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+				else output_ok = 0;
+				break;
+			}
+		}
+		next_slot_ms = ((uint64_t)continuous_last_slot + 1U) * 5000U;
+		if (!microlink_continuous_wait_until(next_slot_ms)) {
+			microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+			break;
+		}
+	}
+
+	/* Execute the one ordinary STOP and native finish before claiming a clean
+	 * end record. atexit cleanup is then idempotently skipped for this mode. */
+	upsdrv_cleanup();
+	cleanup_ok = continuous_cleanup_done && continuous_cleanup_ok;
+	if (!cleanup_ok && continuous_end_reason == MLINK_CONTINUOUS_END_DURATION_COMPLETE) {
+		continuous_end_reason = MLINK_CONTINUOUS_END_GUARD_ERROR;
+		continuous_terminal_latched = 1;
+	} else if (!cleanup_ok) {
+		microlink_continuous_latch_end(MLINK_CONTINUOUS_END_GUARD_ERROR);
+	}
+	if (!continuous_cleanup_clock_ok || continuous_last_elapsed_ms >= 130000U) {
+		output_ok = 0;
+	}
+	if (output_ok && mlink_continuous_end_line(line, sizeof(line),
+		(uint32_t)continuous_last_elapsed_ms,
+		continuous_end_reason)) {
+		output_ok = microlink_continuous_write_line(line);
+	} else {
+		output_ok = 0;
+	}
+	if (cleanup_ok && output_ok
+	 && continuous_end_reason == MLINK_CONTINUOUS_END_DURATION_COMPLETE) result = 0;
+	return result;
+}
