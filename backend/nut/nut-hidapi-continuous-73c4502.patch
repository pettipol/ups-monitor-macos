+static int microlink_continuous_normalize_number(const char *source,
+	char destination[MLINK_CONTINUOUS_MAX_VALUE + 1U])
+{
+	const struct lconv *locale_info;
+	const char *decimal;
+	const char *found;
+	size_t length, decimal_len, prefix_len, suffix_len;
+	if (source == NULL) return 0;
+	length = strlen(source);
+	if (length > MLINK_CONTINUOUS_MAX_VALUE) return 0;
+	locale_info = localeconv();
+	decimal = (locale_info != NULL && locale_info->decimal_point != NULL)
+		? locale_info->decimal_point : ".";
+	if (!strcmp(decimal, ".")) {
+		memcpy(destination, source, length + 1U);
+		return mlink_continuous_number_valid(destination);
+	}
+	decimal_len = strlen(decimal);
+	if (decimal_len == 0U) return 0;
+	found = strstr(source, decimal);
+	if (found == NULL) {
+		memcpy(destination, source, length + 1U);
+		return mlink_continuous_number_valid(destination);
+	}
+	if (strstr(found + decimal_len, decimal) != NULL) return 0;
+	prefix_len = (size_t)(found - source);
+	suffix_len = length - prefix_len - decimal_len;
+	if (prefix_len + 1U + suffix_len > MLINK_CONTINUOUS_MAX_VALUE) return 0;
+	memcpy(destination, source, prefix_len);
+	destination[prefix_len] = '.';
+	memcpy(destination + prefix_len + 1U, found + decimal_len, suffix_len);
+	destination[prefix_len + 1U + suffix_len] = '\0';
+	return mlink_continuous_number_valid(destination);
+}
