+static int microlink_continuous_status_token(const char *token, size_t length)
+{
+	static const char *const allowed[] = {
+		"ALARM", "BOOST", "BYPASS", "CAL", "FSD", "HB", "LB", "OB",
+		"OFF", "OL", "OVER", "RB", "TRIM"
+	};
+	size_t i;
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+		if (strlen(allowed[i]) == length && memcmp(allowed[i], token, length) == 0) return 1;
+	}
+	return 0;
+}
+
+static void microlink_continuous_add_status_token(char tokens[13][8], size_t *count,
+	const char *token, size_t length)
+{
+	size_t i, position;
+	char candidate[8];
+	if (!microlink_continuous_status_token(token, length) || length >= sizeof(candidate)) return;
+	memset(candidate, 0, sizeof(candidate));
+	memcpy(candidate, token, length);
+	candidate[length] = '\0';
+	for (i = 0; i < *count; i++) {
+		if (!strcmp(tokens[i], candidate)) return;
+	}
+	if (*count >= 13U) return;
+	position = *count;
+	while (position > 0U && strcmp(tokens[position - 1U], candidate) > 0) {
+		memcpy(tokens[position], tokens[position - 1U], sizeof(tokens[position]));
+		position--;
+	}
+	memcpy(tokens[position], candidate, sizeof(candidate));
+	(*count)++;
+}
