+int microlink_usb_guard_elapsed_ms(uint64_t *elapsed_ms)
+{
+	int64_t now;
+	if (elapsed_ms == NULL || !state.guard_started || state.guard_invalid
+	 || !clock_now(&now) || now < state.guard_start_ms) {
+		return 0;
