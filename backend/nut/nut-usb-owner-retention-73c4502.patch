+/* A finite number of short relative pauses is an observation budget, not a
+ * deadline guarantee. The shared lock is never held while waiting. */
+static int microlink_usb_async_wait_ack(microlink_async_owner_t *owner,
+	int wait_for_submit)
+{
+	unsigned int i;
+	int acknowledged;
+
+	for (i = 0; i < 100U; i++) {
+		pthread_mutex_lock(&async_lock);
+		acknowledged = wait_for_submit ? owner->submit_done
+			: (owner->callback_terminal && owner->pump_exited);
+		pthread_mutex_unlock(&async_lock);
+		if (acknowledged) {
+			return 1;
+		}
+		(void)usleep(10000U);
+	}
+	pthread_mutex_lock(&async_lock);
+	acknowledged = wait_for_submit ? owner->submit_done
+		: (owner->callback_terminal && owner->pump_exited);
+	pthread_mutex_unlock(&async_lock);
+	return acknowledged;
