+static void microlink_hidapi_initups(void)
+{
+	mlink_hidapi_native_config_t config;
+	mlink_admission_diagnostic_t diagnostic;
+	const char *deadline_text = getval("guard_deadline");
+	const char *p;
+	long deadline = 0;
+	size_t i;
+	uint16_t vid = 0, pid = 0;
+
+	/* All option admission precedes factory allocation and any HIDAPI call. */
+	if (!testvar("hidapi_shared") || !testvar("guarded_monitor")
+	 || device_path == NULL || strcasecmp(device_path, "auto")
+	 || !getval("hid_fallback") || strcasecmp(getval("hid_fallback"), "no")
+	 || !getval("guard_probe_attempts") || strcmp(getval("guard_probe_attempts"), "1")
+	 || !nut_guard_hex_id(getval("guard_vid"), &vid) || vid == 0
+	 || !nut_guard_hex_id(getval("guard_pid"), &pid) || pid == 0
+	 || deadline_text == NULL || *deadline_text == '\0') {
+		fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI requires hidapi_shared, guarded_monitor, port=auto, hid_fallback=no, guard_probe_attempts=1, nonzero exact guard_vid/guard_pid and guard_deadline");
+	}
+	for (i = 0; hidapi_forbidden_options[i] != NULL; i++) {
+		if (testvar(hidapi_forbidden_options[i])) {
+			fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI refuses alternative option %s", hidapi_forbidden_options[i]);
+		}
+	}
+	for (p = deadline_text; *p; p++) {
+		if (*p < '0' || *p > '9' || deadline > 300) {
+			fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI guard_deadline must be decimal 1..300");
+		}
+		deadline = deadline * 10 + (*p - '0');
+	}
+	if (deadline < 1 || deadline > 300) {
+		fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI guard_deadline must be decimal 1..300");
+	}
+	microlink_read_config();
+	srand((unsigned int)microlink_now());
+	guarded_monitor = 1;
+	is_usb = 1;
+	guard_probe_attempt_limit = 1;
+	guarded_deadline_seconds = deadline;
+	memset(&config, 0, sizeof(config));
+	config.vendor_id = vid;
+	config.product_id = pid;
+	config.stop_requested = microlink_hidapi_stop;
+	/* main registers its normal cleanup only AFTER initups returns. */
+	if (atexit(microlink_hidapi_finish) != 0) {
+		fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI could not register early cleanup");
+	}
+	if (!mlink_shared_prepare_native(&config, deadline)) {
+		diagnostic = mlink_shared_admission_diagnostic();
+		fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI one-shot preparation refused stage=%s reason=%s parser=%s",
+			mlink_admission_stage_token(diagnostic.stage),
+			mlink_admission_reason_token(diagnostic.reason),
+			mlink_admission_parser_token(diagnostic.parser_status));
+	}
+	if (microlink_usb_open() != 1) {
+		diagnostic = mlink_shared_admission_diagnostic();
+		fatalx(EXIT_FAILURE, "apcmicrolink HIDAPI one-shot admission failed stage=%s reason=%s parser=%s",
+			mlink_admission_stage_token(diagnostic.stage),
+			mlink_admission_reason_token(diagnostic.reason),
+			mlink_admission_parser_token(diagnostic.parser_status));
+	}
+}
+#endif
