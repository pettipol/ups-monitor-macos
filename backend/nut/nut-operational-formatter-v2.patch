+#include <stdarg.h>
+
+static const char *operational_reason_name(mlink_operational_end_reason_t reason)
+{
+	switch (reason) {
+	case MLINK_OPERATIONAL_END_CANCELLED: return "cancelled";
+	case MLINK_OPERATIONAL_END_DEVICE_LOST: return "device_lost";
+	case MLINK_OPERATIONAL_END_SESSION_LOST: return "session_lost";
+	case MLINK_OPERATIONAL_END_GUARD_ERROR: return "guard_error";
+	case MLINK_OPERATIONAL_END_OUTPUT_ERROR: return "output_error";
+	default: return NULL;
+	}
+}
+
+static int operational_appendf(char *out, size_t out_size, size_t *used,
+	const char *format, ...)
+{
+	va_list arguments;
+	int written;
+	if (out == NULL || used == NULL || format == NULL || *used >= out_size)
+		return 0;
+	va_start(arguments, format);
+	written = vsnprintf(out + *used, out_size - *used, format, arguments);
+	va_end(arguments);
+	if (written < 0 || (size_t)written >= out_size - *used) {
+		out[0] = '\0';
+		return 0;
+	}
+	*used += (size_t)written;
+	return 1;
+}
+
+void mlink_operational_fields_clear(
+	mlink_operational_field_t fields[MLINK_CONTINUOUS_FIELD_COUNT])
+{
+	size_t i;
+	if (fields == NULL) return;
+	for (i = 0; i < MLINK_CONTINUOUS_FIELD_COUNT; i++) {
+		memset(&fields[i], 0, sizeof(fields[i]));
+		fields[i].state = MLINK_CONTINUOUS_UNAVAILABLE;
+		fields[i].kind = expected_kinds[i];
+	}
+}
+
+int mlink_operational_field_observed(mlink_operational_field_t *field,
+	mlink_continuous_kind_t kind, const char *value, uint64_t observed_ms)
+{
+	char copied[sizeof(field->value)];
+	size_t length = 0U;
+	if (field == NULL || value == NULL || kind_name(kind) == NULL
+	 || observed_ms > MLINK_OPERATIONAL_MAX_SAFE_INTEGER)
+		return 0;
+	while (length < sizeof(copied) && value[length] != '\0') length++;
+	if (length >= sizeof(copied)) return 0;
+	memcpy(copied, value, length + 1U);
+	memset(field, 0, sizeof(*field));
+	memcpy(field->value, copied, length + 1U);
+	field->observed_ms = observed_ms;
+	field->kind = kind;
+	field->state = MLINK_CONTINUOUS_OBSERVED;
+	field->has_value = 1;
+	field->has_time = 1;
+	return 1;
+}
+
+void mlink_operational_field_unavailable(mlink_operational_field_t *field,
+	mlink_continuous_kind_t kind)
+{
+	if (field == NULL) return;
+	memset(field, 0, sizeof(*field));
+	field->kind = kind;
+	field->state = MLINK_CONTINUOUS_UNAVAILABLE;
+}
+
+void mlink_operational_field_invalid(mlink_operational_field_t *field,
+	mlink_continuous_kind_t kind)
+{
+	if (field == NULL) return;
+	memset(field, 0, sizeof(*field));
+	field->kind = kind;
+	field->state = MLINK_CONTINUOUS_INVALID;
+}
+
+void mlink_operational_field_mirror(mlink_operational_field_t *destination,
+	const mlink_operational_field_t *source)
+{
+	if (destination == NULL || source == NULL) return;
+	*destination = *source;
+}
+
+static int operational_number_value(const char *value, double *parsed)
+{
+	locale_t c_locale;
+	char *end = NULL;
+	if (value == NULL || parsed == NULL || !mlink_continuous_number_valid(value))
+		return 0;
+	c_locale = newlocale(LC_NUMERIC_MASK, "C", (locale_t)0);
+	if (c_locale == (locale_t)0) return 0;
+	*parsed = strtod_l(value, &end, c_locale);
+	freelocale(c_locale);
+	return end != value && *end == '\0' && isfinite(*parsed);
+}
+
+static int operational_field_valid(const mlink_operational_field_t *field,
+	size_t index, uint64_t elapsed_ms)
+{
+	const char *terminator;
+	double value;
+	if (field == NULL || index >= MLINK_CONTINUOUS_FIELD_COUNT
+	 || kind_name(field->kind) == NULL || state_name(field->state) == NULL
+	 || field->kind != expected_kinds[index])
+		return 0;
+	if ((field->state == MLINK_CONTINUOUS_OBSERVED)
+	 != (field->has_value && field->has_time))
+		return 0;
+	if (field->state != MLINK_CONTINUOUS_OBSERVED
+	 && (field->has_value || field->has_time))
+		return 0;
+	if (field->state != MLINK_CONTINUOUS_OBSERVED) return 1;
+	if (field->observed_ms > MLINK_OPERATIONAL_MAX_SAFE_INTEGER
+	 || field->observed_ms > elapsed_ms)
+		return 0;
+	terminator = memchr(field->value, '\0', sizeof(field->value));
+	if (terminator == NULL || terminator == field->value) return 0;
+	if (index == 0U)
+		return mlink_continuous_status_valid(field->value);
+	if (!operational_number_value(field->value, &value)) return 0;
+	if ((index == 11U || index == 12U) && (value < 0.0 || value > 100.0))
+		return 0;
+	return 1;
+}
+
+static int operational_fields_equal(const mlink_operational_field_t *left,
+	const mlink_operational_field_t *right)
+{
+	if (left->state != right->state || left->kind != right->kind
+	 || left->has_value != right->has_value || left->has_time != right->has_time)
+		return 0;
+	if (left->has_time && left->observed_ms != right->observed_ms) return 0;
+	if (left->has_value && strcmp(left->value, right->value) != 0) return 0;
+	return 1;
+}
+
+static int operational_derived_valid(
+	const mlink_operational_field_t fields[MLINK_CONTINUOUS_FIELD_COUNT],
+	size_t derived_index, size_t load_index, size_t nominal_index)
+{
+	const mlink_operational_field_t *derived = &fields[derived_index];
+	const mlink_operational_field_t *load = &fields[load_index];
+	const mlink_operational_field_t *nominal = &fields[nominal_index];
+	double derived_value, load_value, nominal_value, expected, tolerance;
+	if (derived->state == MLINK_CONTINUOUS_OBSERVED) {
+		if (load->state != MLINK_CONTINUOUS_OBSERVED
+		 || nominal->state != MLINK_CONTINUOUS_OBSERVED
+		 || derived->observed_ms != load->observed_ms
+		 || !operational_number_value(derived->value, &derived_value)
+		 || !operational_number_value(load->value, &load_value)
+		 || !operational_number_value(nominal->value, &nominal_value))
+			return 0;
+		if (nominal_value <= 0.0) return 0;
+		expected = load_value * nominal_value / 100.0;
+		if (!isfinite(expected)) return 0;
+		tolerance = fmax(1e-6, 1e-9 * fmax(fabs(derived_value), fabs(expected)));
+		if (fabs(derived_value - expected) > tolerance) return 0;
+	}
+	if (nominal->state == MLINK_CONTINUOUS_OBSERVED) {
+		if (!operational_number_value(nominal->value, &nominal_value)
+		 || nominal_value <= 0.0)
+			return 0;
+	}
+	return 1;
+}
+
+int mlink_operational_sample_line(char *out, size_t out_size,
+	uint64_t sequence, uint64_t slot, uint64_t elapsed_ms,
+	uint64_t missed_slots,
+	const mlink_operational_field_t fields[MLINK_CONTINUOUS_FIELD_COUNT])
+{
+	size_t used = 0U, i;
+	uint64_t expected_missed;
+	if (out == NULL || fields == NULL || out_size == 0U) return 0;
+	out[0] = '\0';
+	if (sequence < 1U || sequence > MLINK_OPERATIONAL_MAX_SAFE_INTEGER
+	 || slot > MLINK_OPERATIONAL_MAX_SAFE_INTEGER
+	 || elapsed_ms > MLINK_OPERATIONAL_MAX_SAFE_INTEGER
+	 || missed_slots > MLINK_OPERATIONAL_MAX_SAFE_INTEGER
+	 || slot != elapsed_ms / MLINK_OPERATIONAL_SLOT_MS
+	 || sequence > slot + 1U)
+		return 0;
+	expected_missed = slot + 1U - sequence;
+	if (missed_slots != expected_missed) return 0;
+	for (i = 0; i < MLINK_CONTINUOUS_FIELD_COUNT; i++)
+		if (!operational_field_valid(&fields[i], i, elapsed_ms)) return 0;
+	if (!operational_fields_equal(&fields[4], &fields[5])
+	 || !operational_derived_valid(fields, 15U, 11U, 13U)
+	 || !operational_derived_valid(fields, 16U, 12U, 14U))
+		return 0;
+	if (!operational_appendf(out, out_size, &used,
+		"{\"protocol\":\"ups-monitor.continuous.v2\",\"schema_version\":2,\"type\":\"sample\",\"sequence\":%llu,\"slot\":%llu,\"elapsed_ms\":%llu,\"missed_slots\":%llu,\"fields\":{",
+		(unsigned long long)sequence, (unsigned long long)slot,
+		(unsigned long long)elapsed_ms, (unsigned long long)missed_slots))
+		return 0;
+	for (i = 0; i < MLINK_CONTINUOUS_FIELD_COUNT; i++) {
+		const mlink_operational_field_t *field = &fields[i];
+		const char *kind = kind_name(field->kind);
+		const char *state = state_name(field->state);
+		char observed[32];
+		if (field->has_time)
+			snprintf(observed, sizeof(observed), "%llu",
+				(unsigned long long)field->observed_ms);
+		else
+			strcpy(observed, "null");
+		if (!operational_appendf(out, out_size, &used,
+			"%s\"%s\":{\"value\":%s%s%s,\"observed_ms\":%s,\"kind\":\"%s\",\"state\":\"%s\"}",
+			i == 0U ? "" : ",", field_names[i],
+			field->has_value ? "\"" : "",
+			field->has_value ? field->value : "null",
+			field->has_value ? "\"" : "",
+			observed, kind, state))
+			return 0;
+	}
+	if (!operational_appendf(out, out_size, &used, "}}\n")) return 0;
+	return used <= MLINK_CONTINUOUS_MAX_LINE;
+}
+
+int mlink_operational_end_line(char *out, size_t out_size,
+	uint64_t elapsed_ms, mlink_operational_end_reason_t reason)
+{
+	const char *name = operational_reason_name(reason);
+	int written;
+	if (out == NULL || out_size == 0U || name == NULL
+	 || elapsed_ms > MLINK_OPERATIONAL_MAX_SAFE_INTEGER)
+		return 0;
+	written = snprintf(out, out_size,
+		"{\"protocol\":\"ups-monitor.continuous.v2\",\"schema_version\":2,\"type\":\"end\",\"elapsed_ms\":%llu,\"reason\":\"%s\"}\n",
+		(unsigned long long)elapsed_ms, name);
+	return written >= 0 && (size_t)written < out_size
+		&& (size_t)written <= MLINK_CONTINUOUS_MAX_LINE;
+}
