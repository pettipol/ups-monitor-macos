diff --git a/drivers/nut-guarded-policy.h b/drivers/nut-guarded-policy.h
new file mode 100644
index 000000000..1e102bb14
--- /dev/null
+++ b/drivers/nut-guarded-policy.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Experimental Network UPS Tools source helper, not application MIT code. */
+#ifndef NUT_GUARDED_POLICY_H
+#define NUT_GUARDED_POLICY_H
+
+#include <ctype.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef int (*nut_guard_read_id_fn)(void *, size_t, uint16_t *, uint16_t *);
+typedef int (*nut_guard_open_fn)(void *, size_t);
+
+/* Return 0 only after exactly one matching descriptor has been opened. */
+static inline int nut_guard_open_unique(size_t count, uint16_t vid, uint16_t pid,
+	nut_guard_read_id_fn read_id, nut_guard_open_fn open_device, void *context,
+	size_t *selected)
+{
+	size_t i, matches = 0, found = 0;
+	uint16_t candidate_vid, candidate_pid;
+
+	if (!read_id || !open_device || !selected)
+		return -1;
+	for (i = 0; i < count; i++) {
+		if (read_id(context, i, &candidate_vid, &candidate_pid) != 0)
+			return -2;
+		if (candidate_vid == vid && candidate_pid == pid) {
+			found = i;
+			matches++;
+		}
+	}
+	if (matches != 1)
+		return -3;
+	*selected = found;
+	return open_device(context, found) == 0 ? 0 : -4;
+}
+
+static inline int nut_guard_hex_id(const char *text, uint16_t *value)
+{
+	char *end = NULL;
+	unsigned long parsed;
+	size_t i;
+
+	if (!text || !value || strlen(text) != 4)
+		return 0;
+	for (i = 0; i < 4; i++) {
+		if (!isxdigit((unsigned char)text[i]))
+			return 0;
+	}
+	parsed = strtoul(text, &end, 16);
+	if (!end || *end || parsed > 0xFFFFUL)
+		return 0;
+	*value = (uint16_t)parsed;
+	return 1;
+}
+
+static inline int nut_guard_claim_once(int (*claim)(void *), void *context)
+{
+	return claim ? claim(context) : -1;
+}
+
+static inline int nut_guard_allows_control(int guarded)
+{
+	return !guarded;
+}
+
+static inline int nut_guard_allows_dump_mode(int dump_count, int foreground,
+	int command_requested, int force_shutdown, int oldpid_specified)
+{
+	return dump_count > 0 && foreground == 1 && !command_requested
+		&& !force_shutdown && !oldpid_specified;
+}
+
+static inline void nut_guard_maybe_reset(int guarded,
+	void (*reset)(void *), void *context)
+{
+	if (!guarded && reset)
+		reset(context);
+}
+
+/* An unavailable or invalid clock reading fails closed. */
+static inline int nut_guard_deadline_expired(double limit,
+	int (*elapsed)(void *, double *), void *context)
+{
+	double seconds = 0;
+	if (!(limit > 0) || limit > 300.0 || !elapsed
+	 || elapsed(context, &seconds) != 0 || !(seconds >= 0))
+		return 1;
+	return seconds >= limit;
+}
+
+#endif
